// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// BR-15 — Requested Priority must be one of LOW, MEDIUM, HIGH, URGENT.
enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// BR-02 — Every newly created Ticket starts with Current Status `New`.
/// Lab 3 specification.md §7.1 — `OnHold` renamed to `WaitingForRequester`;
/// `Open` and `Reopened` added for the IT Staff status workflow.
enum TicketStatus {
  New
  Open
  InProgress
  WaitingForRequester
  Resolved
  Closed
  Reopened
  Cancelled
}

/// Lab 3 specification.md §7.1 — separate from RequestedPriority so IT Staff
/// triage never overwrites what the Requester asked for (BR-37).
enum ItPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Lab 4 specification.md §7.1 — an Action Taken's own lifecycle, separate
/// from the Ticket's status. Cancelled is terminal (BR-11).
enum ActionStatus {
  Planned
  Completed
  Cancelled
}

// ---------------------------------------------------------------------------
// Reference data
// ---------------------------------------------------------------------------

/// IT request category (Account and Access, Hardware, Software, Network).
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?

  tickets Ticket[]

  // FR-30 — only active Categories are listed; deletedAt is the soft-removal flag.
  @@index([isActive])
  @@index([deletedAt])
}

/// A system or asset a Ticket can be raised against (Campus Wi-Fi, VPN, ...).
model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?

  tickets Ticket[]

  // FR-31 — only active Related Systems are listed.
  @@index([isActive])
  @@index([deletedAt])
}

/// Lab 3 BR-06 — every user has exactly one role.
enum UserRole {
  Requester
  ITStaff
  Administrator
}

// ---------------------------------------------------------------------------
// Users and sessions (Lab 3)
// ---------------------------------------------------------------------------

/// Lab 3 §7.2 — renamed in place from the Lab 2 `DevelopmentRequester`, so ids
/// and Ticket ownership survive the migration (BR-57).
model User {
  id    Int    @id @default(autoincrement())
  name  String
  /// BR-11 — stored trimmed and lower-cased.
  email String @unique

  role UserRole @default(Requester)

  /// BR-12 — bcrypt hash only. Null only for migrated users who have not been
  /// issued an initial password yet; they cannot log in (BR-58).
  passwordHash       String?
  /// BR-02 — true until the user saves a password of their own.
  mustChangePassword Boolean   @default(true)
  passwordChangedAt  DateTime?
  lastLoginAt        DateTime?

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  /// Lab 2 columns retained so no data is dropped; unused in Lab 3.
  department String?
  deletedAt  DateTime?

  /// Tickets submitted by this user as a Requester.
  tickets       Ticket[]        @relation("TicketRequester")
  /// Tickets this user owns as IT Staff or an Administrator (BR-33).
  ownedTickets  Ticket[]        @relation("TicketOwner")
  sessions      Session[]
  publicComments PublicComment[]
  internalNotes  InternalNote[]

  /// Lab 4 — Actions Taken performed by, created by, and last edited by this
  /// user (BR-02, BR-04).
  actionsPerformed ActionTaken[] @relation("ActionPerformedBy")
  actionsCreated   ActionTaken[] @relation("ActionCreatedBy")
  actionsUpdated   ActionTaken[] @relation("ActionUpdatedBy")
  /// Lab 4 — Ticket status changes this user made (BR-24).
  statusChanges    TicketStatusHistory[]

  @@index([isActive])
  @@index([deletedAt])
  @@index([role, isActive])
}

/// BR-17 — server-side session. Only the SHA-256 hash of the cookie token is
/// stored, so a database leak does not hand out working sessions.
model Session {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  createdAt DateTime  @default(now())
  /// BR-18 — absolute expiry, not extended by activity.
  expiresAt DateTime
  /// BR-19 / BR-21 / BR-22 — set on logout or revocation.
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Tickets
// ---------------------------------------------------------------------------

model Ticket {
  id Int @id @default(autoincrement())

  /// BR-01 — backend-generated and unique (e.g. "TT-20260905-0001").
  ticketNumber String @unique

  /// BR-03 — backend timestamp, never supplied by the Requester.
  ticketDate DateTime @default(now())

  requesterId     Int
  categoryId      Int
  relatedSystemId Int

  /// BR-11 — 5–200 characters after trimming (enforced in the service layer).
  summary String @db.VarChar(200)

  /// BR-12 — 10–5000 characters after trimming.
  description String @db.Text

  requestedPriority RequestedPriority
  currentStatus     TicketStatus      @default(New)

  /// Lab 3 §7.4 — new; NOT NULL, copied from `requestedPriority` on create
  /// (BR-37). After that only the Ticket Owner or an Administrator may change it.
  itPriority ItPriority

  /// Lab 3 §7.4 — `null` means Unassigned (BR-33).
  ticketOwnerId Int?

  /// Lab 3 §7.4 / BR-48 — set when the Requester reports the problem appears
  /// resolved; cleared when the Ticket moves to Reopened.
  problemAppearsResolvedAt DateTime?

  /// Lab 4 §7.1 / DD-02 — optimistic concurrency for status changes and
  /// owner/priority edits; `UPDATE ... WHERE id = ? AND version = ?`.
  version Int @default(1)

  /// Lab 4 §7.1 — required Resolution Summary supplied when the Ticket moves
  /// to Resolved (BR-20).
  resolutionSummary String? @db.VarChar(2000)
  resolvedAt        DateTime?
  closedAt          DateTime?
  cancelledAt       DateTime?
  /// Lab 4 §7.1 — required when the Ticket is Cancelled (BR-23).
  cancelReason      String? @db.VarChar(500)
  /// Lab 4 §7.1 / BR-21 — the Requester's advisory "appears resolved"
  /// indication; distinct from the Lab 3 `problemAppearsResolvedAt` signal in
  /// that it is cleared by BR-22 rather than by Reopened alone.
  requesterResolvedIndicatedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  // Reference rows are never hard-deleted out from under a Ticket.
  requester     User          @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  ticketOwner   User?         @relation("TicketOwner", fields: [ticketOwnerId], references: [id], onDelete: Restrict)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  relatedSystem RelatedSystem @relation(fields: [relatedSystemId], references: [id], onDelete: Restrict)

  attachments     Attachment[]
  publicComments  PublicComment[]
  internalNotes   InternalNote[]
  actionsTaken    ActionTaken[]
  statusHistory   TicketStatusHistory[]

  // BR-08 — ownership lookups.
  @@index([requesterId])
  // BR-24 — default list ordering: updatedAt desc within one Requester.
  @@index([requesterId, updatedAt])
  // BR-22 — filters.
  @@index([categoryId])
  @@index([relatedSystemId])
  @@index([requestedPriority])
  @@index([currentStatus])
  // BR-23 — sorting.
  @@index([ticketDate])
  @@index([updatedAt])
  @@index([deletedAt])
  // Lab 3 §7.4 — queue and ownership lookups.
  @@index([ticketOwnerId])
  @@index([itPriority])
  // Lab 4 §7.1 — dashboard metric queries (BR-26..BR-44).
  @@index([requesterId, currentStatus, updatedAt])
  @@index([itPriority, currentStatus])
  @@index([currentStatus, ticketDate])
  @@index([ticketOwnerId, currentStatus])
}

// ---------------------------------------------------------------------------
// Actions Taken and Ticket Workflow (Lab 4)
// ---------------------------------------------------------------------------

/// Lab 4 specification.md §7.1 / DD-01 — the real work performed on a
/// Ticket, kept in its own table (not JSON on Ticket) so it can be
/// authorized, validated, ordered, versioned, and indexed for dashboard
/// queries independently of the Ticket.
model ActionTaken {
  id       Int    @id @default(autoincrement())
  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  /// BR-06 — required; bounded relative to now and the Ticket's createdAt.
  actionAt DateTime

  /// BR-07 — 1–2000 characters after trim.
  description String @db.VarChar(2000)

  /// BR-08 — optional while Planned, required when Completed.
  result String? @db.VarChar(2000)

  status ActionStatus @default(Planned)

  /// BR-02, BR-05 — may differ from the Ticket Owner; must be an active
  /// ITStaff/Administrator.
  performedById Int
  performedBy   User @relation("ActionPerformedBy", fields: [performedById], references: [id], onDelete: Restrict)

  /// BR-04 — always the authenticated creator; never client-supplied.
  createdById Int
  createdBy   User @relation("ActionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  updatedById Int?
  updatedBy   User? @relation("ActionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  /// BR-09 — followUpNote is required when true, null when false.
  followUpRequired Boolean @default(false)
  followUpNote     String? @db.VarChar(1000)

  /// BR-10 — free text pointer into Attachments; never a file upload itself.
  attachmentNotes String? @db.VarChar(500)

  completedAt DateTime?
  cancelledAt DateTime?
  /// BR-12 — required when the action is cancelled.
  cancelReason String? @db.VarChar(500)

  /// BR-15 / DD-04 — idempotency key for create; unique per Ticket so a
  /// repeated submission returns the original row instead of a duplicate.
  clientRequestId String?

  /// DD-02 — optimistic concurrency; edit/complete/cancel all require the
  /// current value and return 409 on a mismatch.
  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([ticketId, clientRequestId])
  // FR-09 — stable list ordering.
  @@index([ticketId, actionAt, createdAt, id])
  // BR-40 (staff dashboard "my open follow-ups").
  @@index([performedById, status, followUpRequired])
}

/// Lab 4 specification.md §7.1 / DD-03, DD-05 — append-only audit trail of
/// every Ticket status change. Kept separate from ActionTaken so the
/// transition history can never be edited or deleted through any endpoint.
model TicketStatusHistory {
  id       Int    @id @default(autoincrement())
  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  /// Null only for the Lab 4 migration backfill's first row per Ticket.
  fromStatus TicketStatus?
  toStatus   TicketStatus

  actorId Int
  actor   User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  /// Resolution summary / cancel reason / reopen reason, depending on
  /// `toStatus`; optional otherwise.
  reason String? @db.VarChar(2000)

  createdAt DateTime @default(now())

  // FR-15 / AC-23 — read oldest to newest per Ticket.
  @@index([ticketId, createdAt])
}

// ---------------------------------------------------------------------------
// Threads (Lab 3)
// ---------------------------------------------------------------------------

/// Lab 3 §7.5 — visible to the Ticket's Requester, IT Staff, and
/// Administrators (BR-04). Kept in its own table, structurally identical to
/// `InternalNote`, so a filtering mistake can never expose a note publicly.
model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String   @db.Text
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

/// Lab 3 §7.5 — visible only to IT Staff and Administrators; never returned
/// to a Requester by any endpoint (BR-04, BR-09).
model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String   @db.Text
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

// ---------------------------------------------------------------------------
// Attachments
// ---------------------------------------------------------------------------

/// BR-32 — metadata record. BR-36 — removal sets `removedAt` instead of
/// deleting the row.
model Attachment {
  id       Int @id @default(autoincrement())
  ticketId Int

  /// BR-33 — display metadata only, never used as a filesystem path.
  originalFilename String

  /// BR-33 — server-generated storage identifier.
  storageKey String @unique

  mimeType String
  fileSize Int

  uploadedAt DateTime @default(now())

  /// Soft removal: non-null means removed (BR-27, BR-36).
  removedAt DateTime?
  /// BR-35 — required, non-empty, when `removedAt` is set.
  removalReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Attachment lookup per Ticket, and the active/removed split (BR-31, BR-38).
  @@index([ticketId])
  @@index([ticketId, removedAt])
  @@index([removedAt])
}
