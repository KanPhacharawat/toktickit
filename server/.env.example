# Copy this file to ".env" and fill in your own local values.
# Do NOT commit your real .env file.
#
# With `npx prisma dev` (local Prisma Postgres), use the DATABASE_URL it prints
# and append `&connection_limit=1&pgbouncer=true`: the embedded server shares
# one session, so Prisma's prepared-statement cache must be off.
DATABASE_URL="postgresql://toktickit:toktickit@localhost:5432/toktickit?schema=public"

# A separate, disposable database used only by the migration test (MIG-01).
# It is wiped on every test run — never point it at real data.
# With `npx prisma dev`, use the SHADOW_DATABASE_URL it prints (same suffix).
MIGRATION_TEST_DATABASE_URL="postgresql://toktickit:toktickit@localhost:5432/toktickit_migration_test"

PORT=3000

# Lab 3 authentication (api-spec.md §1.4)
# The single browser origin allowed to send the session cookie.
CLIENT_ORIGIN="http://localhost:5173"
# Session lifetime in hours (absolute, not extended by activity).
SESSION_TTL_HOURS=8
# Set to true when served over HTTPS.
COOKIE_SECURE=false
# bcrypt cost factor; values below 10 are refused at startup.
BCRYPT_COST=12
